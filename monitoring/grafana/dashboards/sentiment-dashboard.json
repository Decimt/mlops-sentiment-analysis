{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(sentiment_requests_total{endpoint=\"/predict\"}[1m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "title": "Prediction request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(sentiment_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(sentiment_requests_total[5m])), 0.000001)",
          "legendFormat": "5xx error rate",
          "refId": "A"
        }
      ],
      "title": "HTTP error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sentiment_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "P95 prediction latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "sum by (sentiment) (increase(sentiment_predictions_total[10m]))",
          "legendFormat": "{{sentiment}}",
          "refId": "A"
        }
      ],
      "title": "Sentiment distribution (10 min)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(sentiment_input_length_chars_sum[5m])) / clamp_min(sum(rate(sentiment_input_length_chars_count[5m])), 0.000001)",
          "legendFormat": "average characters",
          "refId": "A"
        }
      ],
      "title": "Average input length",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["mlops", "sentiment", "prometheus"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "MLOps Sentiment Service",
  "uid": "mlops-sentiment-service",
  "version": 1
}
